# Demo mode works without any credentials. Live mode needs an OpenAI key.
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint, including /v1 where required.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
VALIDATION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Enable only when you want questions, PDF passages, prompts and answers traced.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tenantflow-langgraph
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
